CAPI=2: 2

name: Yasin:Data:DataVip
description: Data Verification IPCore

filesets:
  tb_files:
    logical_name: tb_lib
    files:
      - src/DataVip.sv
      - src/DataMasterDriver.svh: {is_include_file: true}
      - src/DataMasterItem.svh: {is_include_file: true}
      - src/DataMonitor.svh: {is_include_file: true}
      - src/DataSlaveDriver.svh: {is_include_file: true}
      - src/DataTransaction.svh: {is_include_file: true}
    file_type: systemVerilogSource
    depend:
      - Yasin:TestInterfaces:DataIf

targets:
  default: &default
    filesets:
      - tb_files
